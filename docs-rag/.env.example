# ──────────────────────────────────────────────
# RAG Bootstrap – CONSUMER Environment (image mode)
# ──────────────────────────────────────────────
# Rendered by `rag new-consumer`: the placeholder tokens below are
# substituted with your instance identity/port/paths. Review, then deploy with
# `docker compose -f docker-compose.yml up -d` from this directory.
#
# This consumer runs PRE-BUILT images (no application source). Build them once
# on this host with the canonical repo's `rag build`, then pin the
# tag via RAG_IMAGE_TAG below. See docs/deployment/DISTRIBUTION.md.
#
# HARD PREREQUISITE: a reachable Ollama with the embedding model pulled
# (`ollama pull nomic-embed-text`). `rag doctor` preflights it.
# ──────────────────────────────────────────────

# ── Instance identity ─────────────────────────────────────────────────────────
PROJECT_NAME=electrical-notes
# Docker Compose prefixes every container/network/volume with this — MUST be
# unique per instance on the host (see canonical .env.example for the rationale).
COMPOSE_PROJECT_NAME=electrical-notes
RAG_NETWORK_NAME=electrical-notes-net

# ── Image pin (LOCAL Docker daemon; no registry) ──────────────────────────────
# Consumer compose reads image: rag-bootstrap-*:${RAG_IMAGE_TAG:-latest}. Prefer
# an explicit version so a rebuild/prune cannot silently move `latest`.
RAG_IMAGE_TAG=0.8.3-en

# ── Port scheme — RAG_PORT_BASE derives all published host ports ───────────────
# This stack reserves the 20-wide band [BASE .. BASE+19]. Pick a FREE base that
# is a multiple of 20 and >= 10020 (`rag new-consumer` validates this). The live
# multi-KB docs stack owns 10040 — do NOT reuse it.
RAG_PORT_BASE=10120
RAG_PORT=10120

# ── Data location (DIRECT-PATH: EVERY volume under RAG_DATA_ROOT) ──────────────
# RAG_DATA_ROOT is where this instance keeps ALL its bind-mounted volumes. Point
# it at a roomy disk (e.g. /mnt/quickiespace/electrical-notes). EVERY data volume —
# postgres and redis included (postgres is the BIGGEST) — is a RAG_*_VOLUME under
# this root, so nothing large lands on the home/root partition. The compose init
# service binds RAG_DATA_ROOT and pre-creates these dirs on first `up`.
RAG_DATA_ROOT=/home/devel/rag-data/electrical-notes
RAG_POSTGRES_VOLUME=/home/devel/rag-data/electrical-notes/postgres
RAG_REDIS_VOLUME=/home/devel/rag-data/electrical-notes/redis
RAG_DOCS_VOLUME=/home/devel/rag-data/electrical-notes/docs
RAG_CACHE_VOLUME=/home/devel/rag-data/electrical-notes/cache
RAG_LOGS_VOLUME=/home/devel/rag-data/electrical-notes/logs

# DOCS_PATH: same-path read-only mount so stored citation filepaths are
# host-openable. Set to your REAL docs root; keep RAG_DOCS_VOLUME equal to it if
# you point that elsewhere. Explicit ingest (rag ingest / POST
# /api/ingest) is the primary flow; the ingest-root guard rejects paths outside
# DOCS_PATH (set RAG_INGEST_ROOT_GUARD=off to allow arbitrary container paths).
DOCS_PATH=/home/devel/electrical_notes
RAG_INGEST_ROOT_GUARD=on

# ── PostgreSQL (internal Docker network only; never published) ────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
# CHANGE THIS before a real deploy. Kept out of the image by design — the image
# bakes no secret; this .env is the only place it lives (mode 600, never
# committed). Multi-KB compose reads the same value as POSTGRES_PASSWORD.
POSTGRES_PASSWORD=CHANGEME_generate_with_openssl_rand_hex_24

# ── Redis (internal Docker network only) ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Embeddings — canonical triple (change all three together + reindex) ───────
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_BACKEND=ollama

# --- Embedding-weights pin (PREPARED, NOT ARMED) -----------------------------
# EMBEDDING_MODEL is a TAG, and an Ollama tag is a mutable pointer. If the weights
# behind `nomic-embed-text` are replaced on the shared server, the dimension does
# not change (so the hard guard stays quiet) and the tag does not change (so the
# name warning stays quiet) — but every vector stored before the swap stops being
# comparable with every vector stored after it. Retrieval quality then decays with
# nothing reporting why.
#
# LEAVE EMPTY = UNPINNED = fully inert: no request is issued, nothing is logged,
# behaviour is byte-identical. Setting it makes a weights change LOUD (an ERROR in
# the log and in `rag diagnose --verbose` §11) and still aborts NOTHING.
#
# To arm: read the digest actually being served, then paste it here and recreate
# the api container. The full procedure, and what to do when drift IS reported,
# are in docs/reference/CONFIGURATION.md ("Arming the pin").
#   rag diagnose --verbose      # §11 prints the served blob digest
# EMBEDDING_MODEL_DIGEST=

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=256
CHUNK_OVERLAP=50

# ── Ollama (serves embeddings + LLM generation; EXTERNAL host/remote) ─────────
# host.docker.internal resolves to the host via compose extra_hosts host-gateway.
# Point at a remote Ollama by changing this URL.
# NO LOCAL OLLAMA. err0r does not run an Ollama server -- operator decision,
# 2026-09-05. Models live on remote hosts reached through port_forwards/:
#   :11435 skytracker (155.31.130.52, needs ERAU VPN)  <- this is the default
#   :11436 pwnstar    (10.231.80.91, needs ZeroTier)
# The skytracker tunnel binds the docker bridge as well as 127.0.0.1, so the
# container can reach it via host.docker.internal.
# If no tunnel is up, the stack cannot embed -- bring one up, do NOT start a
# local server to compensate. Check: port_forwards/ollama-guard.sh
OLLAMA_BASE_URL=http://host.docker.internal:11435
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=300

# ── Retrieval ─────────────────────────────────────────────────────────────────
RAG_TOP_K=5
# Ask-path cosine floor. 0.6 (NOT 0.7) for nomic-embed-text: it compresses
# cosine into ~0.50-0.81, so 0.7 sits inside the relevant band and makes
# /api/ask answer "No relevant documents found" while /api/search still
# shows the hits. See docs/reference/RETRIEVAL_QUALITY.md §1.4.
RAG_MIN_SIMILARITY=0.6
# HNSW recall/latency knob (pgvector hnsw.ef_search); 40 = pgvector default.
RAG_HNSW_EF_SEARCH=100

# ── Auto-ingest watcher — OFF by default (fleet inotify safety) ───────────────
# Enable only on single-instance hosts. Prefer `rag sync` (no redeploy)
# or scripts/migrate/ingest tooling for freshness. See canonical .env.example.
# WATCHER_ENABLED=false
# WATCHER_ARCHIVE_MODE=off

# ── Memory caps — per-service hard limits (fleet-resource hardening) ──────────
# Defaults sum to ~1.9GB/stack. Override per instance if needed.
# RAG_API_MEM_LIMIT=512m
# RAG_PG_MEM_LIMIT=1g
# RAG_REDIS_MEM_LIMIT=256m
# RAG_FRONTEND_MEM_LIMIT=128m
# RAG_REDIS_MAXMEMORY=192mb

# ── Monitoring ports (derived; stack works without them) ──────────────────────
# The monitoring stack is a SEPARATE optional compose and is NOT part of a
# consumer deployment. These host ports are listed for reference only — leave
# commented unless you separately run docker-compose.monitoring.yml.
# RAG_PROMETHEUS_PORT=10120  # +10 in the canonical scheme
# RAG_GRAFANA_PORT=                  # +11
# RAG_LOKI_PORT=                     # +12
# RAG_ALERTMANAGER_PORT=             # +13
