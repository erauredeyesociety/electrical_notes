# Ignore OUR build products BY NAME. Do not blanket-ignore *.pdf and try to
# negate the handouts back: a guessed negation (!dsphw*.pdf) silently loses any
# instructor file whose name was not predicted, and those cannot be regenerated.
# Our output has predictable names; the instructor's does not.

p[0-9][0-9]_*.pdf
*_solutions.pdf

# LaTeX intermediates
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# Flattened self-contained copies for Overleaf, generated by
# docs/latex/flatten_tex.sh. Regenerable; the .tex sources are tracked.
overleaf/

__pycache__/
*.py[cod]
